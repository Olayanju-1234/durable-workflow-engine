{
  "name": "workflowd",
  "version": "0.1.1",
  "description": "TypeScript/JavaScript SDK for workflowd, a single-binary durable workflow engine. Zero dependencies.",
  "type": "module",
  "main": "./workflowd.mjs",
  "types": "./workflowd.d.mts",
  "exports": {
    ".": {
      "types": "./workflowd.d.mts",
      "default": "./workflowd.mjs"
    }
  },
  "files": [
    "workflowd.mjs",
    "workflowd.d.mts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "workflow",
    "durable-execution",
    "orchestration",
    "saga",
    "temporal"
  ],
  "license": "Apache-2.0",
  "author": "Joseph Olayanju (https://github.com/Olayanju-1234)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Olayanju-1234/durable-workflow-engine.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/Olayanju-1234/durable-workflow-engine/tree/main/sdks#readme",
  "bugs": {
    "url": "https://github.com/Olayanju-1234/durable-workflow-engine/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
